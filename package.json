{
  "name": "react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "panda codegen && vite",
    "build": "panda codegen && tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "check-all": "pnpm lint && pnpm type-check",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:vrt": "playwright test --grep vrt",
    "test:vrt:update": "playwright test --grep vrt --update-snapshots"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@ark-ui/react": "5.37.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.4",
    "@pandacss/vite": "2.0.0-beta.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lefthook": "^2.1.10",
    "oxlint": "^1.73.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-checker": "^0.14.4"
  }
}